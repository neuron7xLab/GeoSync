python_matrix: /root/.pyenv/versions/3.14.4/bin/python scripts/check_python_matrix.py -> 0
operation_direct: /root/.pyenv/versions/3.14.4/bin/python -m geosync.mfn.cli --out /tmp/mfn-release-evidence run -> 0
