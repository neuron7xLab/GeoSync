{
  "schema": "geosync.component_test_matrix.v1",
  "status": "normative",
  "decision_rule": {
    "controlled_input": "changed repository path",
    "expected_output": "deterministic pytest selector plan",
    "fail_closed_on_invalid_matrix": true,
    "fail_closed_on_unmapped_required_surface": true,
    "allow_empty_plan_for_unmapped_docs": true
  },
  "router_policy": {
    "default_max_run_selectors": 64,
    "priority_component_ids": [
      "controlled_component_test_router"
    ],
    "python_executable_env": "COMPONENT_ROUTER_PYTHON"
  },
  "required_mapping_patterns": [
    ".github/actions/*",
    ".github/workflows/*.yml",
    "constraints/*",
    "core/*",
    "core/*/*",
    "data/governance/*",
    "data/testing/*",
    "requirements*.lock",
    "requirements*.txt",
    "scripts/*",
    "scripts/*/*",
    "tests/*",
    "tests/*/*",
    "tools/*",
    "tools/*/*"
  ],
  "components": [
    {
      "id": "stuart_landau_runtime",
      "description": "Stuart-Landau runtime component.",
      "patterns": [
        "core/physics/stuart_landau_es.py",
        "tests/unit/physics/test_T2b_stuart_landau_es.py",
        "benchmarks/rolling_es_proximity_oos.py",
        "tests/benchmarks/test_rolling_es_proximity_oos_contract.py",
        "tools/verify_rolling_es_strict_replay.py"
      ],
      "selectors": [
        "tests/unit/physics/test_T2b_stuart_landau_es.py",
        "tests/benchmarks/test_rolling_es_proximity_oos_contract.py"
      ],
      "expected_outcome": "pass",
      "isolation_level": "component",
      "max_runtime_seconds": 300
    },
    {
      "id": "stuart_landau_runtime_audit",
      "description": "Stuart-Landau runtime audit component.",
      "patterns": [
        ".github/workflows/mutation-kill-gate.yml",
        "docs/MUTATION_KILL_BASELINE.json",
        "tests/unit/physics/test_T2b_runtime_audit.py",
        "tools/physics/clamp_registry.yaml"
      ],
      "selectors": [
        "tests/unit/physics/test_T2b_runtime_audit.py"
      ],
      "expected_outcome": "pass",
      "isolation_level": "component",
      "max_runtime_seconds": 120
    },
    {
      "id": "dependency_operational_determinism",
      "description": "Dependency determinism component.",
      "patterns": [
        ".github/actions/setup-geosync/action.yml",
        ".github/workflows/dependency-operational-determinism.yml",
        "constraints/security.txt",
        "requirements*.txt",
        "requirements*.lock",
        "tools/deps/check_operational_dependency_determinism.py",
        "tests/deps/test_operational_dependency_determinism.py",
        "tests/ci/test_setup_geosync_toolchain.py"
      ],
      "selectors": [
        "tests/deps/test_operational_dependency_determinism.py",
        "tests/ci/test_setup_geosync_toolchain.py"
      ],
      "expected_outcome": "pass",
      "isolation_level": "component",
      "max_runtime_seconds": 120
    },
    {
      "id": "company_value_functions",
      "description": "Company value-function component.",
      "patterns": [
